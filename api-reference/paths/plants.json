{
  "plants_list": {
    "get": {
      "description": "Returns all plants from the system that the user has access to",
      "parameters": [
        {
          "name": "limit",
          "in": "query",
          "description": "The maximum number of results to return",
          "schema": {
            "type": "integer",
            "format": "int32"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Plant response",
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "../schemas/Plants.json#/Plant"
                }
              }
            }
          }
        },
        "400": {
          "description": "Unexpected error",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/Errors.json#/Error"
              }
            }
          }
        }
      }
    },
    "post": {
      "description": "Creates a new plant in the store",
      "requestBody": {
        "description": "Plant to add to the store",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/Plants.json#/NewPlant"
            }
          }
        },
        "required": true
      },
      "responses": {
        "200": {
          "description": "plant response",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/Plants.json#/Plant"
              }
            }
          }
        },
        "400": {
          "description": "unexpected error",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/Errors.json#/Error"
              }
            }
          }
        }
      }
    }
  },
  "plants_by_id": {
    "delete": {
      "description": "Deletes a single plant based on the ID supplied",
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "description": "ID of plant to delete",
          "required": true,
          "schema": {
            "type": "integer",
            "format": "int64"
          }
        }
      ],
      "responses": {
        "204": {
          "description": "Plant deleted",
          "content": {}
        },
        "400": {
          "description": "unexpected error",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/Errors.json#/Error"
              }
            }
          }
        }
      }
    }
  }
}

