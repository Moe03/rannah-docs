      "parameters": [
        {
          "name": "client_id",
          "in": "path",
          "description": "The ID of the client to update",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "requestBody": {
        "description": "Client to update",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/Client.json#/ClientModelPost"
            }
          }
        },
        "required": true
      },
      "security": [
        {
          "bearerWorkspace": []
        }
      ],
      "responses": {
        "200": {
          "description": "Client updated successfully",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "success": {
